# Puerto en el que corre la aplicación
PORT=3000

# Cadena de conexión de tu base de datos Postgres (Neon).
# La obtienes en el panel de Neon: Dashboard del proyecto -> "Connection string".
# Debe verse algo así (con SSL incluido):
# postgresql://usuario:contraseña@ep-algo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:contraseña@tu-proyecto.neon.tech/neondb?sslmode=require

# Deja esto tal cual para Neon (requiere SSL). Solo defínelo como "disable" si estás
# probando contra un Postgres local en tu propia máquina sin SSL.
# PGSSL=disable

# Clave secreta para firmar las sesiones (usa un valor largo y aleatorio en producción)
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Credenciales del administrador inicial (solo se usan la primera vez que se ejecuta el seed,
# es decir, cuando la tabla de usuarios está vacía)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiarClave123
